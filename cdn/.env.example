# CDN Server Configuration
PORT=8080
TLS_PORT=8443
TLS_ENABLED=true
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem
CDN_BASE_URL=http://localhost:8080
MAX_UPLOAD_SIZE_MB=500

# RustFS Object Storage (matches ../Infra/rustfs)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=braingain
S3_ACCESS_KEY_ID=braingain
S3_SECRET_ACCESS_KEY=braingain-secret
S3_USE_PATH_STYLE=true
