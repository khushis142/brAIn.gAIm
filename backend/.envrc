use flake

export COMPOSE_FILE=docker-compose.dev.yaml

# Start local Postgres on entering the directory (no-op if already running).
# They have no restart policy, so they are gone after a reboot until you cd in again.
if has docker; then
  docker compose up -d >/dev/null 2>&1 \
    || log_error "docker compose up failed; run 'docker compose up -d' to see why"
fi
