# Copy to .env for local dev (values match docker-compose.dev.yaml).
# For deployment, load this file into the Portainer stack (Environment variables →
# "Load variables from .env file") and replace every value. All are required unless
# marked optional.

# postgresql://USER:PASSWORD@HOST:5432/DB (the async driver is selected automatically)
DATABASE_URL=postgresql+asyncpg://braingain:braingain@localhost:5432/braingain

# Public base URL of the CDN service (github.com/brAIn-gAIm/CDN)
CDN_BASE_URL=http://localhost:8080

# Optional: Piper TTS HTTP server, needed only by games with a `tts` precondition
TTS_URL=http://localhost:5000

# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Optional, defaults to "fake": the LLM adapter for the game generator.
# - "fake" needs no key (minimal valid data, the reference quiz as a generated game); CI uses it.
# - "litellm" talks to the LiteLLM proxy from docker-compose.yaml (Anthropic, budgeted).
# - "ollama" talks to a self-hosted model with an OpenAI-compatible API, e.g. the team's
#   server; no key, no cost, but small models write weaker games.
LLM_PROVIDER=fake
# litellm: a model alias from litellm/config.yaml (default "smart") and a budgeted virtual
# key of the proxy (README → Deployment), never the Anthropic key. LLM_BASE_URL defaults to
# the proxy in docker-compose.yaml; locally, e.g. http://localhost:4000.
# LLM_MODEL=smart
# LLM_API_KEY=sk-...
# ollama: the server's /v1 URL (defaults to http://localhost:11434/v1) and a model it serves
# (list them with: curl <url>/models).
# LLM_BASE_URL=http://192.168.188.67:8082/v1
# LLM_MODEL=unsloth/Qwen3-1.7B-GGUF:Q4_K_M

# Deployment only (the litellm service in docker-compose.yaml):
# Anthropic API key of the production workspace (it has a monthly spend limit)
ANTHROPIC_API_KEY=change-me
# Admin key of the proxy, starts with sk-: python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=change-me
# Encrypts keys stored in the proxy's database; never change it after the first start
LITELLM_SALT_KEY=change-me
# A separate database for the proxy on the same Postgres
LITELLM_DATABASE_URL=postgresql://braingain:braingain@localhost:5432/litellm
