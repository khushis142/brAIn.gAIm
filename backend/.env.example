# Postgres (async driver required)
DATABASE_URL=postgresql+asyncpg://braingain:braingain@localhost:5432/braingain

# S3 / S3-compatible storage. Leave S3_ENDPOINT_URL empty for AWS.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=braingain
S3_ACCESS_KEY_ID=braingain
S3_SECRET_ACCESS_KEY=braingain-secret

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
