meta {
  name: Generate flashcards
  type: http
  seq: 9
}

post {
  url: {{api}}/projects/{{projectId}}/flashcards
  body: none
  auth: inherit
}

docs {
  One LLM call from the project's body and text/PDF attachments; an unchanged project
  returns the existing cards. 422 if there is no text at all.
}
