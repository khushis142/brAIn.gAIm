meta {
  name: Register video
  type: http
  seq: 2
}

post {
  url: {{api}}/content
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{fileId}}",
    "filename": "{{filename}}",
    "kind": "video",
    "title": "My video",
    "tags": ["learning"]
  }
}

docs {
  Upload an .mp4 with **cdn/Upload file** first.
}
