{
  "context": "Create short, encouraging configuration text for a reaction game that teaches focus and sustained attention. Use the player's study context to make the wording relevant. Set difficulty to easy, normal, or hard. Keep every text field short enough for a phone-sized scoreboard and pause menu.",
  "input_schema": {
    "type": "object",
    "required": [
      "context",
      "difficulty",
      "pauseTitle",
      "pauseMessage",
      "resumeLabel",
      "leaderboardTitle",
      "leaderboardSubtitle",
      "scoreLabel"
    ],
    "properties": {
      "context": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "difficulty": {
        "type": "string",
        "enum": ["easy", "normal", "hard"]
      },
      "pauseTitle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48
      },
      "pauseMessage": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "resumeLabel": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "leaderboardTitle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48
      },
      "leaderboardSubtitle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "scoreLabel": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "additionalProperties": false
  }
}
