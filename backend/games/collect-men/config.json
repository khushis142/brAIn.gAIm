{
  "context": "Create short, encouraging configuration text for a 3D lane-running quiz game that tests recall of the study material. Set difficulty to easy, normal, or hard. Keep text short for a phone-sized scoreboard and pause menu. Provide a list of questions with each question having three answers: two incorrect ones and one correct answer. Keep the questions and answers short enough to fit on a phone screen.",
  "renderer": "webgl",
  "orientation": "portrait",
  "minDurationSeconds": 20,
  "maxDurationSeconds": 60,
  "input": ["touch", "keyboard"],
  "assets": [],
  "input_schema": {
    "type": "object",
    "required": [
      "context",
      "difficulty",
      "pauseTitle",
      "pauseMessage",
      "resumeLabel",
      "leaderboardTitle",
      "leaderboardSubtitle",
      "scoreLabel",
      "questions"
    ],
    "properties": {
      "context": { "type": "string", "minLength": 1, "maxLength": 120 },
      "difficulty": { "type": "string", "enum": ["easy", "normal", "hard"] },
      "pauseTitle": { "type": "string", "minLength": 1, "maxLength": 48 },
      "pauseMessage": { "type": "string", "minLength": 1, "maxLength": 120 },
      "resumeLabel": { "type": "string", "minLength": 1, "maxLength": 32 },
      "leaderboardTitle": { "type": "string", "minLength": 1, "maxLength": 48 },
      "leaderboardSubtitle": { "type": "string", "minLength": 1, "maxLength": 120 },
      "scoreLabel": { "type": "string", "minLength": 1, "maxLength": 32 },
      "questions": {
        "type": "array",
        "minItems": 3,
        "maxItems": 8,
        "items": {
          "type": "object",
          "required": ["question", "answer_correct", "answer_incorrect", "answer_incorrect2"],
          "properties": {
            "question": { "type": "string", "minLength": 1, "maxLength": 120 },
            "answer_correct": { "type": "string", "minLength": 1, "maxLength": 80 },
            "answer_incorrect": { "type": "string", "minLength": 1, "maxLength": 80 },
            "answer_incorrect2": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
